# PassVault Environment Configuration Example

# Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/passvault
JWT_SECRET=super_secret_jwt_key_change_in_production_at_least_32_characters_long
COOKIE_SECRET=super_secret_cookie_key_change_in_production

# Docker Environment Configuration
MONGO_INITDB_ROOT_USERNAME=vaultadmin
MONGO_INITDB_ROOT_PASSWORD=vaultsecret
MONGO_INITDB_DATABASE=passvault
